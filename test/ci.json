  "items": {"about": "inventory, crafting, creative mode, dropped items and saves, durability, held items, block variants", "tests": ["furnace-removed", "creative-rclick", "creative-trash", "creative-vinv", "drops-save", "durability-actions", "held-items", "mining-vanilla", "open-screen-save", "wood-variants"]},
  "ui": {"about": "screens and input: debug screen and its views, villager screens and hover cards, overlays, Escape and mouse release, title screen, death screen, sign editor, slash commands", "tests": ["cmd-unknown", "compare", "compare-view", "death-lightning", "death-screens", "debug-alerts", "debug-inventory", "debug-screen", "economy-view", "esc-close", "esc-slider", "overlay-behind", "seed-copy", "sign-full-paste", "time-add-limit", "title-hotkeys", "tp-below-world", "tp-far", "villager-hover", "villager-screens", "z-release"]}
